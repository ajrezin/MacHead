{
  "id": "/",
  "name": "MacHead Dash — 云端无头远控台",
  "short_name": "MacHead",
  "description": "端到端加密的 Mac 远程多标签终端、Web 文件管理器与无头模式实时控制台",
  "lang": "zh-CN",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
